{
  "manifest_version": 3,
  "name": "TapHoa39 - Tải XML HĐĐT",
  "version": "2.0.0",
  "description": "Kế toán bấm Tìm kiếm trên hoadondientu.gdt.gov.vn → extension tự tải XML mọi hóa đơn trong kết quả.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://hoadondientu.gdt.gov.vn/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://hoadondientu.gdt.gov.vn/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://hoadondientu.gdt.gov.vn/*"],
      "js": ["common.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_icon": "icon128.png" },
  "icons": { "128": "icon128.png" }
}
